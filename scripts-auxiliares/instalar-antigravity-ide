#!/bin/bash

export VERDE="\033[1;32m"
export VERMELHO="\033[1;31m"
export AMARELO="\033[1;33m"
export NORMAL="\033[0m"

export NOME="Antigravity IDE"
export BINARIO="antigravity-ide"
export DIR_INSTALACAO_BASE="/opt"
export DIR_INSTALACAO="$DIR_INSTALACAO_BASE/Antigravity-IDE"
export URL_PAGINA="https://antigravity.google/download"
export URL_ARQUIVO=$(curl -sL --compressed "$URL_PAGINA" | grep -oE 'https://[^"]*/linux-x64/Antigravity%20IDE\.tar\.gz' | head -1)
export ULTIMA_VERSAO=$(echo "$URL_ARQUIVO" | awk -F'/stable/' '{print $2}' | awk -F'[-/]' '{print $1}')

if [ -z "$URL_ARQUIVO" ]; then
    echo -e "\n${VERMELHO}Não foi possível obter o link de download do $NOME.${NORMAL}"
    echo -e "${VERMELHO}Pode ser um problema de conexão ou a página $URL_PAGINA mudou de estrutura.${NORMAL}\n"
    exit 1
fi

if [ -d "$DIR_INSTALACAO" ]; then
    VERSAO_INSTALADA=$(grep -oP '"ideVersion":\s*"\K[^"]+' "$DIR_INSTALACAO/resources/app/product.json" 2>/dev/null)

    if [ "$VERSAO_INSTALADA" == "$ULTIMA_VERSAO" ]; then
        echo -e "\n${AMARELO}A versão mais recente do $NOME já está instalada.${NORMAL}"
        echo -e "Versão atual: ${VERDE}$ULTIMA_VERSAO${NORMAL}\n"

        while [[ "$RESPOSTA_INSTALAR_NOVAMENTE" != [sSnN] ]]; do
            read -p "Deseja reinstalar? [s/n] " RESPOSTA_INSTALAR_NOVAMENTE < /dev/tty
        done

        if [[ "$RESPOSTA_INSTALAR_NOVAMENTE" == [nN] ]]; then
            exit 0
        fi
        MENSAGEM_SUCESSO="reinstalado"
        MENSAGEM_ERRO="reinstalar"
    else
        echo -e "\n${VERDE}Atualizando o $NOME da versão $VERSAO_INSTALADA para $ULTIMA_VERSAO...${NORMAL}\n"
        MENSAGEM_SUCESSO="atualizado"
        MENSAGEM_ERRO="atualizar"
    fi
else
    echo -e "\n${VERDE}Instalando $NOME $ULTIMA_VERSAO...${NORMAL}\n"
    MENSAGEM_SUCESSO="instalado"
    MENSAGEM_ERRO="instalar"
fi

sudo -E -- bash -c '
    set -e
    echo -e "\n${VERDE}Baixando o $NOME $ULTIMA_VERSAO...${NORMAL}\n"
    ARQUIVO_BAIXADO="/tmp/Antigravity-IDE.tar.gz"
    wget -q --show-progress --read-timeout=5 --tries=0 -cO ${ARQUIVO_BAIXADO} ${URL_ARQUIVO}
    rm -rf "$DIR_INSTALACAO"
    mkdir -p "$DIR_INSTALACAO"

    echo -e "\nExtraindo o arquivo baixado \"${ARQUIVO_BAIXADO}\" para \"$DIR_INSTALACAO\"...\n"
    pv ${ARQUIVO_BAIXADO} | tar -xz -C ${DIR_INSTALACAO} --strip-components=1
    rm -f ${ARQUIVO_BAIXADO}

    rm -f /usr/local/bin/$BINARIO
    ln -s "$DIR_INSTALACAO/bin/$BINARIO" /usr/local/bin/$BINARIO
    chown -R $SUDO_USER: "$DIR_INSTALACAO"

    chown root:root "$DIR_INSTALACAO/chrome-sandbox"
    chmod 4755 "$DIR_INSTALACAO/chrome-sandbox"

    echo -e "\nCriando atalho no menu...\n"
    printf "%s\n"                              \
        "[Desktop Entry]"                      \
        "Encoding=UTF-8"                       \
        "Name=$NOME"                           \
        "Comment=IDE agentic do Google"        \
        "Exec=$BINARIO"                        \
        "Icon=$DIR_INSTALACAO/resources/app/resources/linux/code.png" \
        "Terminal=false"                       \
        "Type=Application"                     \
        "Categories=Development;IDE;"          \
        "StartupNotify=true"                   \
        "StartupWMClass=Antigravity IDE" > /usr/share/applications/$BINARIO.desktop
' < /dev/tty

RETORNO=$?
if [ $RETORNO -eq 0 ]; then
    echo -e "\n${VERDE}O $NOME $ULTIMA_VERSAO foi $MENSAGEM_SUCESSO com sucesso.${NORMAL}\n"
    echo -e "${VERDE}Você pode iniciar o $NOME a partir do menu ou executando o comando \"$BINARIO\" no terminal.${NORMAL}"
else
    echo -e "\n${VERMELHO}Ocorreu um erro ao $MENSAGEM_ERRO o $NOME $ULTIMA_VERSAO.${NORMAL}\n"
    echo -e "${VERMELHO}Por favor, tente novamente.${NORMAL}"
fi
