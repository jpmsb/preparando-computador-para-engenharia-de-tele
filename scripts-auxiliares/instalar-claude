#!/bin/bash

export VERDE="\033[1;32m"
export VERMELHO="\033[1;31m"
export AMARELO="\033[1;33m"
export NORMAL="\033[0m"

export NOME="Claude"
export BINARIO="claude-desktop"
export DIR_INSTALACAO_BASE="/opt"
export DIR_INSTALACAO="$DIR_INSTALACAO_BASE/$NOME"
export URL_PAGINA="https://claude.com/download"
export URL_INDICE="https://downloads.claude.ai/claude-desktop/apt/stable/dists/stable/main/binary-amd64/Packages"
export URL_BASE_DOWNLOAD="https://downloads.claude.ai/claude-desktop/apt/stable"

# O Claude Desktop no Linux é distribuído como .deb (Ubuntu/Debian). A versão
# mais recente vem do índice apt oficial da Anthropic.
export CAMINHO_PACOTE=$(curl -sL "$URL_INDICE" |
    grep '^Filename: pool/main/c/claude-desktop/claude-desktop_' |
    sort -V |
    tail -n 1 |
    cut -d' ' -f2)
export ULTIMA_VERSAO=$(echo "$CAMINHO_PACOTE" | grep -oP 'claude-desktop_\K[^_]+')
export URL_ARQUIVO="$URL_BASE_DOWNLOAD/$CAMINHO_PACOTE"

if [ -z "$ULTIMA_VERSAO" ] || [ -z "$CAMINHO_PACOTE" ]; then
    echo -e "\n${VERMELHO}Não foi possível obter o link de download do $NOME.${NORMAL}"
    echo -e "${VERMELHO}Pode ser um problema de conexão ou a página $URL_PAGINA mudou de estrutura.${NORMAL}\n"
    exit 1
fi

if [ -d "$DIR_INSTALACAO" ]; then
    VERSAO_INSTALADA=$(cat "$DIR_INSTALACAO/installed-version" 2>/dev/null)

    if [ "$VERSAO_INSTALADA" == "$ULTIMA_VERSAO" ]; then
        echo -e "\n${AMARELO}A versão mais recente do $NOME já está instalada.${NORMAL}"
        echo -e "Versão atual: ${VERDE}$ULTIMA_VERSAO${NORMAL}\n"

        while [[ "$RESPOSTA_INSTALAR_NOVAMENTE" != [sSnN] ]]; do
            read -p "Deseja reinstalar? [s/n] " RESPOSTA_INSTALAR_NOVAMENTE < /dev/tty
        done

        if [[ "$RESPOSTA_INSTALAR_NOVAMENTE" == [nN] ]]; then
            exit 0
        fi
        MENSAGEM_SUCESSO="reinstalado"
        MENSAGEM_ERRO="reinstalar"
    else
        echo -e "\n${VERDE}Atualizando o $NOME da versão $VERSAO_INSTALADA para $ULTIMA_VERSAO...${NORMAL}\n"
        MENSAGEM_SUCESSO="atualizado"
        MENSAGEM_ERRO="atualizar"
    fi
else
    echo -e "\n${VERDE}Instalando $NOME $ULTIMA_VERSAO...${NORMAL}\n"
    MENSAGEM_SUCESSO="instalado"
    MENSAGEM_ERRO="instalar"
fi

sudo -E -- bash -c '
    set -e
    echo -e "\n${VERDE}Baixando o $NOME $ULTIMA_VERSAO...${NORMAL}\n"
    ARQUIVO_BAIXADO="/tmp/$NOME.deb"
    DIR_EXTRACAO="/tmp/$NOME-extract"
    wget -q --show-progress --read-timeout=5 --tries=0 -cO ${ARQUIVO_BAIXADO} ${URL_ARQUIVO}

    rm -rf "$DIR_EXTRACAO"
    mkdir -p "$DIR_EXTRACAO"
    echo -e "\nExtraindo o pacote \"${ARQUIVO_BAIXADO}\"...\n"
    (cd "$DIR_EXTRACAO" && ar x "$ARQUIVO_BAIXADO" data.tar.xz)

    rm -rf "$DIR_INSTALACAO"
    mkdir -p "$DIR_INSTALACAO"
    echo -e "\nInstalando em \"$DIR_INSTALACAO\"...\n"
    # ./usr/lib/claude-desktop/<arquivo> → 4 componentes até o conteúdo do app
    pv "$DIR_EXTRACAO/data.tar.xz" | tar -xJ -C "$DIR_INSTALACAO" --strip-components=4 ./usr/lib/claude-desktop

    echo "$ULTIMA_VERSAO" > "$DIR_INSTALACAO/installed-version"
    rm -f /usr/local/bin/$BINARIO
    ln -s "$DIR_INSTALACAO/claude-desktop" /usr/local/bin/$BINARIO
    chown -R $SUDO_USER: "$DIR_INSTALACAO"

    chown root:root "$DIR_INSTALACAO/chrome-sandbox"
    chmod 4755 "$DIR_INSTALACAO/chrome-sandbox"

    echo -e "\nCriando atalho no menu...\n"
    printf "%s\n"                                 \
        "[Desktop Entry]"                         \
        "Encoding=UTF-8"                          \
        "Name=$NOME"                              \
        "Comment=Aplicativo desktop do Claude.ai" \
        "Exec=$BINARIO %U"                        \
        "Icon=$DIR_INSTALACAO/resources/icon.png" \
        "Terminal=false"                          \
        "Type=Application"                        \
        "Categories=Utility;Development;"         \
        "StartupNotify=true"                      \
        "StartupWMClass=com.anthropic.Claude" > /usr/share/applications/$BINARIO.desktop

    rm -rf "$DIR_EXTRACAO" "$ARQUIVO_BAIXADO"
' < /dev/tty

RETORNO=$?
if [ $RETORNO -eq 0 ]; then
    echo -e "\n${VERDE}O $NOME $ULTIMA_VERSAO foi $MENSAGEM_SUCESSO com sucesso.${NORMAL}\n"
    echo -e "${VERDE}Você pode iniciar o $NOME a partir do menu ou executando o comando \"$BINARIO\" no terminal.${NORMAL}"
else
    echo -e "\n${VERMELHO}Ocorreu um erro ao $MENSAGEM_ERRO o $NOME $ULTIMA_VERSAO.${NORMAL}\n"
    echo -e "${VERMELHO}Por favor, tente novamente.${NORMAL}"
fi
